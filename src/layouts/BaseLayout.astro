---
import 'katex/dist/katex.min.css';
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Toussaint Workbook</title>
    <style is:global>
      :root {
        --bg: #ffffff;
        --fg: #1a1a2e;
        --surface: #f9f9fb;
        --surface-2: #f0f0f5;
        --border: #e0e0e8;
        --accent: #4f46e5;
        --accent-2: #059669;
        --danger: #dc2626;
        color-scheme: light dark;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #14141f;
          --fg: #e8e8f0;
          --surface: #1c1c2b;
          --surface-2: #24243a;
          --border: #33334d;
          --accent: #818cf8;
          --accent-2: #34d399;
        }
      }
      * { box-sizing: border-box; }
      body {
        background: var(--bg);
        color: var(--fg);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        line-height: 1.65;
        max-width: 780px;
        margin: 0 auto;
        padding: 2rem 1.25rem 5rem;
      }
      h1, h2, h3 { line-height: 1.25; }
      h2 { margin-top: 2.5rem; border-bottom: 1px solid var(--border); padding-bottom: 0.3rem; }
      code { background: var(--surface-2); padding: 0.1em 0.35em; border-radius: 0.3em; font-size: 0.9em; }
      pre { background: var(--surface-2); padding: 1rem; border-radius: 0.5rem; overflow-x: auto; }
      table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
      th, td { border: 1px solid var(--border); padding: 0.4rem 0.6rem; text-align: left; font-size: 0.92rem; }
      a { color: var(--accent); }
      @media print {
        body { max-width: none; padding: 0; }
        .no-print { display: none !important; }
      }
    </style>
  </head>
  <body>
    <slot />
    <script>
      import renderMathInElement from 'katex/contrib/auto-render';
      function renderMath() {
        renderMathInElement(document.body, {
          delimiters: [
            { left: '$$', right: '$$', display: true },
            { left: '$', right: '$', display: false },
          ],
          throwOnError: false,
        });
      }
      // Module scripts run after the document has parsed, which can be after
      // DOMContentLoaded already fired — so check readyState instead of only listening.
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderMath);
      } else {
        renderMath();
      }
    </script>
  </body>
</html>
