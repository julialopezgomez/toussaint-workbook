---
import BaseLayout from './BaseLayout.astro';

interface SourceRef {
  sourceId: string;
  pages: string;
  role: 'primary' | 'supplementary' | 'cross-reference';
}
interface NotationItem { symbol: string; meaning: string; }
interface ExternalSource { citation: string; note: string; }
interface NeighborModule { id: string; block: string; title: string; }
interface Props {
  id: string;
  block: string;
  title: string;
  tier: 1 | 2 | 3 | 4;
  estimatedHours: number;
  prerequisites: string[];
  objectives: string[];
  sources: SourceRef[];
  externalSources?: ExternalSource[];
  concepts: string[];
  notation: NotationItem[];
  cheatsheetLinks: string[];
  nextModules: string[];
  prev?: NeighborModule | null;
  next?: NeighborModule | null;
}
const { id, block, title, tier, estimatedHours, prerequisites, objectives, sources, externalSources, concepts, notation, cheatsheetLinks, prev, next } =
  Astro.props as Props;

const tierLabel: Record<number, string> = {
  1: 'Core — main route',
  2: 'Main route (sequenced early)',
  3: 'Optional branch',
  4: 'Reference only',
};
---
<BaseLayout title={`${id} · ${title}`}>
  <nav class="no-print breadcrumb"><a href="/">Start</a> / <a href={`/curriculum#${block}`}>{block}</a> / {id}</nav>

  <header>
    <p class="module-id">{id}</p>
    <h1>{title}</h1>
    <div class="badges">
      <span class="badge">{tierLabel[tier]}</span>
      <span class="badge">~{estimatedHours} hrs</span>
      <span class="badge">block: {block}</span>
    </div>
  </header>

  {prerequisites.length > 0 && (
    <section class="meta-box">
      <h3>Prerequisites</h3>
      <p>{prerequisites.join(', ')}</p>
    </section>
  )}

  <section class="meta-box">
    <h3>Learning objectives</h3>
    <ul>
      {objectives.map((o: string) => <li set:html={o} />)}
    </ul>
  </section>

  {notation.length > 0 && (
    <section class="meta-box">
      <h3>Notation</h3>
      <table>
        <thead><tr><th>Symbol</th><th>Meaning</th></tr></thead>
        <tbody>
          {notation.map((n: NotationItem) => (
            <tr><td set:html={n.symbol} /><td>{n.meaning}</td></tr>
          ))}
        </tbody>
      </table>
    </section>
  )}

  <article>
    <slot />
  </article>

  <footer class="module-footer">
    {sources.length > 0 && (
      <section class="meta-box">
        <h3>Sources cited in this module</h3>
        <ul>
          {sources.map((s: SourceRef) => <li><code>{s.sourceId}</code> {s.pages} <em>({s.role})</em></li>)}
        </ul>
      </section>
    )}
    {externalSources && externalSources.length > 0 && (
      <section class="meta-box">
        <h3>External sources cited in this module</h3>
        <ul>
          {externalSources.map((s: ExternalSource) => (
            <li>{s.citation}<div class="ext-note">{s.note}</div></li>
          ))}
        </ul>
      </section>
    )}
    {concepts.length > 0 && (
      <p class="concepts"><strong>Concepts:</strong> {concepts.join(' · ')}</p>
    )}
    {cheatsheetLinks.length > 0 && (
      <p class="no-print">
        {cheatsheetLinks.map((c: string) => <a href={`/cheatsheets/${c}`}>📄 Cheat sheet: {c}</a>)}
      </p>
    )}
  </footer>

  <nav class="no-print prev-next">
    {prev ? (
      <a class="nav-link prev" href={`/course/${prev.block}/${prev.id}`}>
        <span class="nav-label">← Previous</span>
        <span class="nav-title">{prev.id}: {prev.title}</span>
      </a>
    ) : <span />}
    {next ? (
      <a class="nav-link next" href={`/course/${next.block}/${next.id}`}>
        <span class="nav-label">Next →</span>
        <span class="nav-title">{next.id}: {next.title}</span>
      </a>
    ) : <span />}
  </nav>

  <style>
    .breadcrumb { font-size: 0.85rem; opacity: 0.7; margin-bottom: 1rem; }
    .breadcrumb a { color: inherit; }
    .module-id { font-family: ui-monospace, monospace; color: var(--accent); font-weight: 600; margin: 0; }
    h1 { margin-top: 0.2rem; }
    .badges { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
    .badge {
      background: var(--surface-2); border: 1px solid var(--border); border-radius: 999px;
      padding: 0.2rem 0.75rem; font-size: 0.8rem;
    }
    .meta-box {
      background: var(--surface); border: 1px solid var(--border); border-radius: 0.6rem;
      padding: 0.9rem 1.2rem; margin: 1rem 0;
    }
    .meta-box h3 { margin-top: 0; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.03em; opacity: 0.75; }
    .module-footer { margin-top: 3rem; border-top: 1px solid var(--border); padding-top: 1rem; }
    .concepts { font-size: 0.85rem; opacity: 0.8; }
    .ext-note { font-size: 0.85rem; opacity: 0.7; margin-top: 0.2rem; }
    .prev-next {
      display: flex; justify-content: space-between; gap: 1rem; margin-top: 1.5rem;
    }
    .nav-link {
      display: flex; flex-direction: column; max-width: 48%; padding: 0.7rem 1rem;
      border: 1px solid var(--border); border-radius: 0.5rem; background: var(--surface);
      text-decoration: none; color: inherit;
    }
    .nav-link.next { text-align: right; margin-left: auto; }
    .nav-label { font-size: 0.75rem; opacity: 0.6; text-transform: uppercase; letter-spacing: 0.03em; }
    .nav-title { font-size: 0.9rem; margin-top: 0.15rem; }
  </style>
</BaseLayout>
