{
  "name": "toussaint-workbook",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "grading-server": ".venv/bin/python scripts/grading/sympy_server.py",
    "extract-pdfs": ".venv/bin/python scripts/ingest/extract_pdfs.py",
    "fetch-html-notes": ".venv/bin/python scripts/ingest/fetch_html_notes.py"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "astro": "^7.2.1",
    "katex": "^0.18.4",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.185.1"
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3"
  }
